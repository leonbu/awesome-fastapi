PROJECT_NAME="FastAPI Starter"
ENVIRONMENT=development
SECRET_KEY=development_secret_key_change_in_production_min_32_chars_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# SQLite (default for zero-config local development)
DATABASE_URL=sqlite+aiosqlite:///./app.db

# PostgreSQL (uncomment and configure to use Postgres instead)
# POSTGRES_SERVER=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=app_db
